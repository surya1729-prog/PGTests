{
  "name": "medical-pg-papers",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 8083",
    "android": "expo run:android",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "android:studio": "npx cap open android",
    "build:web": "expo export --platform web",
    "cap:sync": "npm run build:web && npx cap sync android",
    "cap:open": "npm run cap:sync && npx cap open android",
    "cap:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android"
  },
  "private": true
}
